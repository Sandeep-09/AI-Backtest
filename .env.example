# Folder on the VPS that holds your Databento files (e.g. /root/databento/raw). Mounted read-only.
DATABENTO_DIR=/root/databento/raw

# OpenRouter key for strategy interpretation. Without it the app uses the offline keyword parser.
OPENROUTER_API_KEY=
# Model id on OpenRouter. Check https://openrouter.ai/models?q=deepseek for the current DeepSeek ids.
LLM_MODEL=deepseek/deepseek-chat

# Host port for the dashboard. It listens on 127.0.0.1 only (no login built in);
# use an SSH tunnel, or set BIND_ADDR=0.0.0.0 only behind your own auth/firewall.
PORT=8000
BIND_ADDR=127.0.0.1
